rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Contact forms & customer submissions (anyone can submit, only team can read/manage)
    match /inquiries/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
    match /contact_inquiries/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
    match /distributor_applications/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
    match /bulk_quotes/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
    match /subscribers/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Visitor analytics logs (public site can record, admin team can read/manage)
    match /visitor_logs/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
    
    // 2. Product Prices (public can read live prices, logged-in admins can update)
    match /product_prices/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 3. Blog Articles (public can read published posts, logged-in admins can create/edit/delete)
    match /articles/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /blog_posts/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 4. Staff profiles & team roles
    match /profiles/{id} {
      allow read, write: if request.auth != null;
    }
    match /user_roles/{id} {
      allow read, write: if request.auth != null;
    }
  }
}
