rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Anyone can submit contact forms, but only your team can read them
    match /inquiries/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
    match /distributor_applications/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
    match /bulk_quotes/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
    
    // 2. Only logged-in admin team members can see user accounts and roles
    match /profiles/{id} {
      allow read, write: if request.auth != null;
    }
    match /user_roles/{id} {
      allow read, write: if request.auth != null;
    }
  }
}
