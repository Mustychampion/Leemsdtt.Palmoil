rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Blog images: public can view, authenticated staff can upload/delete
    match /blog/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // General fallback
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
